{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutate": [
    "src/lib/dice-engine.ts",
    "src/lib/combat-calc.ts"
  ],
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "concurrency": 4,
  "timeoutMS": 15000
}
