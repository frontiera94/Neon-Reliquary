{
  "test-on-code-edit": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/validate-tests.mjs",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "build-and-test-on-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/validate-build-and-tests.mjs",
        "timeout": 300
      }
    ]
  }
}
