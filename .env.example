# Neon Postgres connection string (injected automatically when connecting Neon in Vercel Storage)
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Anthropic API key for /api/chat
ANTHROPIC_API_KEY=sk-ant-...

# Sheet Upload & Notification Queue
# Passphrase required for players to upload a PDF sheet (default: reliquary_secret)
UPLOAD_PASSPHRASE=reliquary_secret

# Telegram Bot Notifications (DM / Group alert when a new sheet is uploaded)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=-1001234567890
APP_BASE_URL=https://neon-reliquary.vercel.app
